{
  "name": "@bluewave/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "cross-env VITE_BLUEWAVE_DEBUG=true electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "pnpm build && electron-builder --config",
    "pack:mac": "pnpm build && electron-builder --mac --config",
    "pack:win": "pnpm build && electron-builder --win --config",
    "pack:linux": "pnpm build && electron-builder --linux --config",
    "clean": "rimraf --glob out dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "snap": "node scripts/view.ts",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "lint": "vp lint .",
    "lint:fix": "echo 'ok'"
  },
  "dependencies": {
    "@bluewave/contracts": "workspace:*",
    "@bluewave/diagnostics": "workspace:*",
    "@bluewave/deterministic": "workspace:*",
    "@bluewave/content-schema": "workspace:*",
    "@bluewave/content-compiler": "workspace:*",
    "@bluewave/campaign": "workspace:*",
    "@bluewave/campaign-engine": "workspace:*",
    "@bluewave/combat": "workspace:*",
    "@bluewave/commands": "workspace:*",
    "@bluewave/events": "workspace:*",
    "@bluewave/persistence": "workspace:*",
    "@bluewave/phase-engine": "workspace:*",
    "@bluewave/random": "workspace:*",
    "zod": "^3.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@base-ui/react": "^1.7.0",
    "@paper-design/shaders-react": "^0.0.62",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "@bluewave/test-support": "workspace:*",
    "electron": "41.10.4",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "vite": "catalog:",
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0",
    "vite-plus": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.15",
    "@tailwindcss/vite": "^4.1.15",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.1.0",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-zoom": "^3.0.8",
    "@types/topojson-client": "^3.1.5",
    "@playwright/test": "^1.49.0",
    "cross-env": "^7.0.3"
  }
}
