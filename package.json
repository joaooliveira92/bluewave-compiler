{
  "name": "bluewave",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check --ignore-path=.oxfmtignore .",
    "format:fix": "oxfmt --write --ignore-path=.oxfmtignore .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "vitest run",
    "test:cross-process": "node packages/cross-process-test/dist/run-child.js",
    "clean": "turbo run clean && rimraf .turbo",
    "clean:all": "pnpm clean && rimraf node_modules",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test:run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "6.0.1",
    "turbo": "^2.4.0",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  }
}
