{
  "name": "bluewave",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "vitest run",
    "test:cross-process": "node packages/cross-process-test/dist/run-child.js",
    "clean": "turbo run clean && rm -rf node_modules",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test:run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
