{
  "name": "bluewave",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "preflight": "node scripts/preflight.cjs",
    "snap": "pnpm --filter @bluewave/desktop build && pnpm --filter @bluewave/desktop run snap",
    "snap:debug": "pnpm --filter @bluewave/desktop exec cross-env VITE_BLUEWAVE_DEBUG=true electron-vite build && pnpm --filter @bluewave/desktop run snap",
    "dev": "node scripts/preflight.cjs && turbo run dev",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @bluewave/desktop test:e2e",
    "test:run": "pnpm -r --filter='!prototype' exec vp test run",
    "test:cross-process": "node packages/cross-process-test/dist/run-child.js",
    "clean": "turbo run clean && rimraf .turbo",
    "clean:all": "pnpm clean && rimraf node_modules",
    "check": "node scripts/preflight.cjs && pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test:run && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "6.0.1",
    "turbo": "^2.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^3.24.0"
  }
}
