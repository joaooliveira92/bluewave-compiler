#!/bin/sh
# Re-run the fast gates before pushing, in case a commit used --no-verify.
# `preflight` first, then the Effect Oxlint gate (ADR-0139): it is part of
# `pnpm check` and CI, and ~2s, so it belongs here too. Fail-fast at the first
# red gate.
node scripts/run-gates.mjs preflight || exit 1
exec pnpm lint:effect
