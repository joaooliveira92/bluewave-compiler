{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "concurrency": "32",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "desktop#build": {
      "outputs": ["out/**"]
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@bluewave/ship-visual#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/ship-visual/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
